# JobPulse 后端环境变量示例
# 复制为 .env 并替换 <your-key-here>

# 数据库
DATABASE_URL=sqlite:///data/jobpulse.db

# 允许访问 API 的前端源（逗号分隔；线上请填写实际站点 URL）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3100,http://127.0.0.1:3100

# LLM API（邮件解析用，替换为你的真实 Key）
OPENAI_API_KEY=<your-openai-key-here>
DEEPSEEK_API_KEY=<your-deepseek-key-here>
LLM_MODEL=deepseek-chat

# 采集配置
CRAWL_INTERVAL_MINUTES=60
CRAWL_MAX_CONCURRENT=3
CRAWL_USER_AGENT=JobPulse/1.0
# 公共演示环境应设为 false，避免匿名用户触发外部采集
CRAWLER_TRIGGER_ENABLED=true

# 业务阈值
NO_RESPONSE_DAYS=14

# Demo 数据重置（非演示环境务必关闭）
DEMO_RESET_ENABLED=true

# AI 限流
LLM_TIMEOUT=5
LLM_MAX_PER_MINUTE=10

# 日志级别（DEBUG/INFO/WARNING/ERROR）
LOG_LEVEL=INFO
